# NOTE: data/ and models/ are NOT ignored here on purpose.
# DVC writes its own .gitignore next to every output it tracks
# (data/raw/, data/processed/, models/), and refuses outputs that Git already ignores.

# Other model and checkpoint formats (model.joblib is DVC-tracked, so *.joblib is NOT ignored)
*.pkl
*.pickle
*.pt
*.pth
*.ckpt
*.h5
*.hdf5
*.onnx

# Secrets and local configuration
.env
.env.*
!.env.example
.dvc/config.local
.pypirc

# DVC local cache and temporary files
/.dvc/cache/
/.dvc/tmp/

# Python environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Python caches and compiled files
__pycache__/
*.py[cod]
*$py.class
*.so

# Package build artifacts
build/
dist/
*.egg-info/
*.egg
.eggs/
pip-wheel-metadata/

# Test, coverage and lint caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.hypothesis/
.tox/
.nox/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover
*.py,cover

# CML CI metrics
ci-metrics.json

# Notebook checkpoints
.ipynb_checkpoints/

# Experiment tracking logs
mlruns/

# Operating system and editor temporary files
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~

# Logs
*.log
pip-log.txt
pip-delete-this-directory.txt

# Generated documentation
docs/site/
/site/

# Keep these reproducibility files tracked:
# pyproject.toml
# uv.lock
# .python-version
# dvc.yaml
# dvc.lock
# .dvc/config
# params.yaml